# Environment overrides for the uma4agents demo stack.
# Copy to .env to change any of these. All have working defaults in
# docker-compose.yml — see the "Demo credentials — not secrets" section of the
# README. These are LOCAL LAB defaults, not secrets; do not reuse them anywhere
# real or expose this stack on a public network.

# Keycloak bootstrap admin password
KC_ADMIN_PASSWORD=uma4agents-admin

# OAuth client secret the gateway/PEP exchanges for its PAT at the
# authorization server (client_credentials, scope uma_protection)
UMA_AS_RS_CLIENT_SECRET=gateway-dev-secret

# Portal browser-session signing secret
PORTAL_SESSION_SECRET=dev-session-secret

# Person-server admin/person token
PS_ADMIN_TOKEN=uma4agents-ps-admin

# Set to "none" to bypass OIDC login in headless environments
# PORTAL_AUTH=oidc

# --- Deployment modes (both values are conformant; the demo runs the defaults) ---

# How the AS learns what the resource protects.
#   pull (default) — the RS publishes; the AS reads its RFC 9728 metadata and
#                    the protected owner-resources listing.
#   push           — classic FedAuthz: the RS registers each surface at /rreg.
# Keep uma-as and uma-pep in step.
# REGISTRATION_MODE=pull

# Who carries the FedAuthz enforcement obligations.
#   gateway (default) — an ext_authz service ahead of the resource; the MCP
#                       server holds no auth code at all.
#   embedded          — the resource enforces in-process via an MCP Extension
#                       and there is no gateway in the authorization path.
# See `make embedded-check`.
# ENFORCEMENT_MODE=gateway

# Origins accepted when a browser-context caller presents one (MCP 2026-07-28
# requires Origin validation). Agents send no Origin, so this only bites for
# browsers. Comma-separated.
# UMA_ALLOWED_ORIGINS=https://gateway.uma.lab,https://portal.uma.lab

# Bob's firm's public presence: the CIMD document and Web Bot Auth key
# directory his agent points at. Set empty to run without either.
# UMA4A_AGENT_OPERATOR=https://agent.uma.lab

# How long the shim polls Alice's AS before handing the wait back to Bob's
# client as an MCP input_required. Short on purpose — a pend is a state to
# render, not a call to hold open.
# UMA4A_PEND_HANDBACK=15
