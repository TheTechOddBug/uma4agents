# Every third-party version the reference architecture depends on, in one
# file, so that "what is this built against?" has a single answer and an
# upgrade is a diff rather than an archaeology exercise.
#
# Resolved and verified 2026-08-12. Nothing here floats: a lab whose whole
# argument is "this runs" cannot have a platform that changes underneath it
# between two people cloning it a week apart.

# The Gateway API itself. Standard channel — the experimental channel adds
# TCPRoute/TLSRoute, which nothing here needs.
GATEWAY_API_VERSION=v1.6.0

# TLS for *.uma.lab, issued in-cluster. This is what removes mkcert, openssl
# and `make init` from the Kubernetes path entirely.
CERT_MANAGER_VERSION=v1.21.1
TRUST_MANAGER_VERSION=v0.24.0

# Istio ambient: ztunnel for L4 identity and mTLS, waypoints for the two L7
# path rules that L4 cannot express. No sidecars.
ISTIO_VERSION=1.30.3

# The north-south edge. Gateway API implementation number one.
KGATEWAY_VERSION=v2.4.2

# The agent-facing gateway that hosts the enforcement point. Gateway API
# implementation number two — two GatewayClasses in one cluster, which is
# itself worth showing.
AGENTGATEWAY_VERSION=v1.4.1

# Postgres as a Kubernetes resource, with synchronous replication and
# automated failover, so the authorization server's single-use guarantees
# survive a node going away.
CNPG_VERSION=0.29.0

# kmcp is what makes Alice's vault a first-class Kubernetes object rather
# than a Deployment we happened to write. It ships its own chart, and it
# needs both halves: kagent's CRD chart carries the MCPServer type, but the
# type alone reconciles nothing — without the controller an MCPServer is
# accepted by the API server and then simply sits there, with no status and
# no Deployment, which is a quiet way to lose an afternoon.
KAGENT_VERSION=0.9.12
KMCP_VERSION=0.3.0

# Observability. Same images the compose stack uses.
LOKI_VERSION=3.4.2
GRAFANA_VERSION=11.6.0
