{
  "name": "UMA for Agents — Kubernetes lab",

  // A plain Debian base. The toolchain is installed by features and
  // post-create rather than baked, so what runs here is what the README asks
  // you to install locally — no divergence between the two paths.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    // docker-IN-docker, not docker-outside-of-docker. kind runs its nodes as
    // containers and needs a daemon it can own; the outside-of-docker variant
    // shares the host socket and cannot host them.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "installDockerBuildx": true
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "kubectl": "latest",
      "helm": "latest",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // So the lab can be driven over `gh codespace ssh` from a real terminal,
    // not only from the browser editor.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  // The cluster is three nodes and measures ~5.4 GB before the platform
  // charts go on, so this asks for a machine that can actually hold it.
  // GitHub selects the smallest type meeting every field.
  //
  // Note for the visitor: this lands on a larger machine, which consumes the
  // monthly Codespaces allowance faster than the default. The guide says so.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "onCreateCommand": "bash .devcontainer/post-create.sh",

  // Alice's portal and her identity provider. Both serve plain HTTP inside
  // the cluster — the edge terminates TLS — which is exactly what Codespaces
  // port forwarding wants. `make codespaces-web` wires them up.
  // Declared here so they show up in the PORTS tab with names rather than as
  // bare numbers — that tab, beside the terminal, is how you reach the portal
  // once `make codespaces-web` has run. It lists what is listening and gives
  // you an open-in-browser action.
  //
  // openPreview puts her portal in VS Code's built-in browser once the port
  // is forwarded. Note it hooks the event where VS Code detects a *newly
  // listening* port — a port named in forwardPorts is forwarded eagerly at
  // container start, so this may not fire until 9010 is taken out of that
  // list. Left declared for now because the labels are what make the PORTS
  // tab readable, and PORTS is the path that works regardless.
  "forwardPorts": [9010, 8080],
  "portsAttributes": {
    "9010": { "label": "Alice's portal", "onAutoForward": "openPreview" },
    "8080": { "label": "Alice's identity provider", "onAutoForward": "silent" }
  },

  "customizations": {
    // Open the walkthrough on arrival, beside the terminal, so the Codespace
    // explains itself without anyone going looking.
    //
    // The topology diagram comes last so it is the tab you land beside the
    // guide on: it is the deployed shape this lab builds, and its namespaces
    // are the ones `kubectl get pods -A` will show.
    //
    // Two documented limits: this fires only the first time a Codespace is
    // opened, and only in the browser client — not desktop VS Code. The
    // post-create message covers those cases by naming the files.
    "codespaces": {
      "openFiles": [
        "START-HERE.md",
        "docs/KUBERNETES.md",
        "docs/k8s-topology.png"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml"
      ],
      "settings": {
        // Markdown opens rendered rather than as source, so the guide reads
        // as a guide.
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "vscode"
}
